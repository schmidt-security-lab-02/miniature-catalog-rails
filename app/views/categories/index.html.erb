<section class="heading"><div><p class="eyebrow">ORGANIZAÇÃO</p><h1>Categorias da coleção</h1></div><%= link_to "Nova categoria", new_category_path, class: "button" %></section>
<section class="grid"><% @categories.each do |category| %><article class="card"><h2><%= category.name %></h2><p><%= category.description %></p><p class="muted"><%= category.miniatures.size %> modelos</p><div class="actions"><%= link_to "Ver miniaturas", miniatures_path(category_id: category.id) %><%= link_to "Editar", edit_category_path(category) %><%= button_to "Remover", category_path(category), method: :delete, class: "text-button" %></div></article><% end %></section>
