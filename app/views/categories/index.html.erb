<section class="heading"><div><p class="eyebrow">ORGANIZATION</p><h1>Collection categories</h1></div><%= link_to "New category", new_category_path, class: "button" %></section>
<section class="grid"><% @categories.each do |category| %><article class="card"><h2><%= category.name %></h2><p><%= category.description %></p><p class="muted"><%= category.miniatures.size %> models</p><div class="actions"><%= link_to "View miniatures", miniatures_path(category_id: category.id) %><%= link_to "Edit", edit_category_path(category) %><%= button_to "Delete", category_path(category), method: :delete, class: "text-button" %></div></article><% end %></section>
