<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Miniature — collection catalog</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <header class="topbar"><%= link_to "MINIATURE", root_path, class: "brand" %><nav><%= link_to "Collection", miniatures_path %><%= link_to "Categories", categories_path %><%= link_to "New miniature", new_miniature_path, class: "button" %></nav></header>
    <main class="container">
      <% if notice %><p role="status" class="notice"><%= notice %></p><% end %>
      <% if alert %><p role="alert" class="errors"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer class="container footer">Organize categories, scales, and painting progress across your collection.</footer>
  </body>
</html>
