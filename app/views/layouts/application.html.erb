<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Miniatura — catálogo da coleção</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <header class="topbar"><%= link_to "MINIATURA", root_path, class: "brand" %><nav><%= link_to "Coleção", miniatures_path %><%= link_to "Categorias", categories_path %><%= link_to "Nova miniatura", new_miniature_path, class: "button" %></nav></header>
    <main class="container">
      <% if notice %><p role="status" class="notice"><%= notice %></p><% end %>
      <% if alert %><p role="alert" class="errors"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer class="container footer">Organize categorias, escalas e o progresso da sua coleção.</footer>
  </body>
</html>
