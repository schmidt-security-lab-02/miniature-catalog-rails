<%= link_to "← Back to the collection", miniatures_path %>
<section class="detail"><span class="badge"><%= @miniature.category.name %></span><h1><%= @miniature.name %></h1><p><%= @miniature.manufacturer %> · <%= @miniature.universe %></p><dl><dt>Scale</dt><dd><%= @miniature.scale.presence || "Not provided" %></dd><dt>Quantity</dt><dd><%= @miniature.quantity %></dd><dt>Painting</dt><dd><%= @miniature.status_label %></dd></dl><h2>Collection notes</h2><%= simple_format(@miniature.notes.presence || "No notes yet.") %><div class="actions"><%= link_to "Edit miniature", edit_miniature_path(@miniature), class: "button" %><%= button_to "Delete miniature", @miniature, method: :delete, class: "button secondary" %></div></section>
