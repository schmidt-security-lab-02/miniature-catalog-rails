<%= link_to "← Voltar à coleção", miniatures_path %>
<section class="detail"><span class="badge"><%= @miniature.category.name %></span><h1><%= @miniature.name %></h1><p><%= @miniature.manufacturer %> · <%= @miniature.universe %></p><dl><dt>Escala</dt><dd><%= @miniature.scale.presence || "Não informada" %></dd><dt>Quantidade</dt><dd><%= @miniature.quantity %></dd><dt>Pintura</dt><dd><%= @miniature.status_label %></dd></dl><h2>Notas da coleção</h2><%= simple_format(@miniature.notes.presence || "Sem observações.") %><div class="actions"><%= link_to "Editar miniatura", edit_miniature_path(@miniature), class: "button" %><%= button_to "Remover miniatura", @miniature, method: :delete, class: "button secondary" %></div></section>
