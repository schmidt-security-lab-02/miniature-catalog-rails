<section class="hero"><p class="eyebrow">YOUR COLLECTION IN ORDER</p><h1>Small pieces.<br>Endless worlds.</h1><p>Find every miniature and keep track of what is still on your workbench.</p><span class="badge"><%= @total %> models in your collection</span></section>
<%= form_with url: miniatures_path, method: :get, class: "filters" do |form| %>
  <label>Search<%= form.search_field :q, value: @query, placeholder: "Name, manufacturer, or universe", maxlength: 100 %></label>
  <label>Category<%= form.collection_select :category_id, @categories, :id, :name, { include_blank: "All categories", selected: params[:category_id] } %></label>
  <label>Painting<%= form.select :painting_status, Miniature::STATUSES.map { |value, label| [label, value] }, { include_blank: "All statuses", selected: params[:painting_status] } %></label>
  <%= form.submit "Filter", class: "button" %>
<% end %>
<section class="grid" aria-label="Miniatures">
  <% @miniatures.each do |miniature| %>
    <article class="card"><div class="piece" aria-hidden="true">◈</div><span class="badge"><%= miniature.category.name %></span><h2><%= link_to miniature.name, miniature %></h2><p><%= [miniature.manufacturer, miniature.universe].reject(&:blank?).join(" · ") %></p><div class="card-meta"><span>Scale <%= miniature.scale.presence || "—" %></span><span><%= miniature.status_label %></span></div></article>
  <% end %>
</section>
<% if @miniatures.empty? %><section class="empty"><h2>No miniatures found</h2><p>Adjust the filters or add the first piece to your collection.</p></section><% end %>
<p class="muted">Up to 100 results are displayed per search.</p>
