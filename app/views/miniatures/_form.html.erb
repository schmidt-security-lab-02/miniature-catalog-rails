<%= form_with model: miniature, class: "editor" do |form| %>
  <% if miniature.errors.any? %><div role="alert" class="errors"><h2>Confira os campos</h2><ul><% miniature.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="form-grid"><label>Nome<%= form.text_field :name, required: true, maxlength: 120 %></label><label>Categoria<%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Selecione" }, required: true %></label><label>Fabricante<%= form.text_field :manufacturer, maxlength: 100 %></label><label>Universo<%= form.text_field :universe, maxlength: 100 %></label><label>Escala<%= form.text_field :scale, maxlength: 100, placeholder: "1:32 ou 28 mm" %></label><label>Quantidade<%= form.number_field :quantity, min: 1, max: 10000, required: true %></label><label>Pintura<%= form.select :painting_status, Miniature::STATUSES.map { |value, label| [label, value] } %></label></div>
  <label>Notas<%= form.text_area :notes, rows: 5, maxlength: 2000 %></label><div class="actions"><%= form.submit "Salvar miniatura", class: "button" %><%= link_to "Cancelar", miniatures_path %></div>
<% end %>
