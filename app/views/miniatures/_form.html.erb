<%= form_with model: miniature, class: "editor" do |form| %>
  <% if miniature.errors.any? %><div role="alert" class="errors"><h2>Check the fields below</h2><ul><% miniature.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="form-grid"><label>Name<%= form.text_field :name, required: true, maxlength: 120 %></label><label>Category<%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Select a category" }, required: true %></label><label>Manufacturer<%= form.text_field :manufacturer, maxlength: 100 %></label><label>Universe<%= form.text_field :universe, maxlength: 100 %></label><label>Scale<%= form.text_field :scale, maxlength: 100, placeholder: "1:32 or 28 mm" %></label><label>Quantity<%= form.number_field :quantity, min: 1, max: 10000, required: true %></label><label>Painting<%= form.select :painting_status, Miniature::STATUSES.map { |value, label| [label, value] } %></label></div>
  <label>Notes<%= form.text_area :notes, rows: 5, maxlength: 2000 %></label><div class="actions"><%= form.submit "Save miniature", class: "button" %><%= link_to "Cancel", miniatures_path %></div>
<% end %>
